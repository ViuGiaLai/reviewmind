# Keep false when accounts are enabled; true is only for isolated local demos.
REVIEWMIND_ALLOW_ANONYMOUS=false
REVIEWMIND_CORS_ORIGINS=http://localhost:8080

CLERK_SECRET_KEY=
CLERK_DOMAIN=
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=

REVIEWMIND_GEMINI_API_KEY=
REVIEWMIND_OPENAI_API_KEY=
REVIEWMIND_OPENROUTER_API_KEY=
REVIEWMIND_GITHUB_TOKEN=

# Performance & capacity
REVIEWMIND_PG_POOL_SIZE=10
REVIEWMIND_PG_MAX_OVERFLOW=20
REVIEWMIND_DB_STATEMENT_TIMEOUT_MS=30000
REVIEWMIND_MAX_CONCURRENT_REVIEWS=4
REVIEWMIND_REVIEW_QUEUE_TIMEOUT_SECONDS=2
REVIEWMIND_MAX_FILE_SIZE=52428800
REVIEWMIND_UPLOAD_CHUNK_SIZE=1048576